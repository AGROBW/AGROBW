{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://js.hcaptcha.com https://*.hcaptcha.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://nominatim.openstreetmap.org https://viacep.com.br https://ipinfo.io https://ip-api.com https://olinda.bcb.gov.br https://*.hcaptcha.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com https://*.hcaptcha.com https://www.youtube-nocookie.com https://www.youtube.com https://www.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/sitemap",
      "destination": "/api/og-loja?_seo_route=sitemap"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/og-loja?_seo_route=sitemap"
    },
    {
      "source": "/anuncio/:id",
      "destination": "/api/og-loja?_seo_route=document&path=/anuncio/:id"
    },
    {
      "source": "/loja/:slug",
      "destination": "/api/og-loja?_seo_route=document&path=/loja/:slug"
    },
    {
      "source": "/noticias/:slug",
      "destination": "/api/og-loja?_seo_route=document&path=/noticias/:slug"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/og-loja?_seo_route=document&path=/p/:slug"
    },
    {
      "source": "/categoria/:slug",
      "destination": "/api/og-loja?_seo_route=document&path=/categoria/:slug"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(anuncios|categorias|planos|vitrine|patrocinador|lojas-parceiras|contato|noticias|quem-somos|termos-de-uso|privacidade|politica-de-cookies|politica-de-precos|login|cadastro|redefinir-senha|anunciar|mensagens|favoritos)",
      "destination": "/index.html"
    },
    {
      "source": "/minha-conta/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico|robots.txt|sitemap.xml|meta-oauth-callback.html|index.html).*)",
      "destination": "/api/og-loja?_seo_route=document&path=/$1"
    }
  ]
}
